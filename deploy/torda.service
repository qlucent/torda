# Sample systemd unit for torda — runs in daemon mode, streaming OCSF
# NDJSON to a rotating file on disk. A log shipper (Vector/Filebeat/Splunk-UF)
# tails that file and carries events to your SIEM; the agent itself makes no
# network call (see docs/DEPLOY.md).
#
# Install:
#   sudo cp deploy/torda.service /etc/systemd/system/
#   sudo mkdir -p /etc/torda /var/log/torda
#   sudo cp deploy/torda.toml /etc/torda/config.toml   # then edit it
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now torda
#
# Build the binary referenced by ExecStart first — see docs/DEPLOY.md for the
# per-OS feature flag (`linux-ebpf` here) and why it needs root/CAP_BPF.

[Unit]
Description=torda — unified security agent (daemon mode, OCSF file sink)
Documentation=https://github.com/ (see docs/DEPLOY.md in this repo)
After=network-online.target
Wants=network-online.target
# Crash-loop guard: stop retrying after 5 failed starts in 60s
# (`systemctl reset-failed torda` clears it).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# eBPF collection (process/network/file events) needs root or CAP_BPF+CAP_PERFMON
# to open kernel probes, and the binary must be built with `--features linux-ebpf`
# (`cargo build --release --features linux-ebpf` from torda/). Without
# that feature, or without the required privilege, the agent fails soft to the
# stub event bus and still runs (snapshot modules keep working) — it will not
# crash, but it will not capture real kernel events either.
User=root
# Config-driven: daemon mode + the file sink are set in the TOML config below.
# CLI flags still override the config (e.g. append `--output /other/path`).
ExecStart=/usr/local/bin/torda --config /etc/torda/config.toml
# Uncomment to bound a run for testing instead of running forever (e.g. a
# canary/smoke deploy): the agent exits 0 cleanly after N seconds.
# Environment=TORDA_RUN_SECS=60
Restart=on-failure
RestartSec=5s

# --- Footprint bounds: keep it "one light agent". Tune for your fleet. ---
MemoryHigh=192M
MemoryMax=256M
CPUQuota=40%
TasksMax=128

# --- Least privilege: run as root (collection needs it) but BOUND the capability
# set to what collection actually uses. eBPF load needs CAP_BPF + CAP_PERFMON
# (kernel >= 5.8) or CAP_SYS_ADMIN (older); reading /proc + package DBs needs
# CAP_DAC_READ_SEARCH / CAP_SYS_PTRACE. Add caps here if your kernel needs them. ---
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYSLOG

# --- Sandboxing that does NOT interfere with eBPF/ETW collection ---
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true
# systemd creates /var/log/torda (0755) and makes it writable — no pre-create,
# no ReadWritePaths-on-missing-dir startup failure. Point the OCSF file sink here.
LogsDirectory=torda

# --- Agent diagnostics to the journal (OCSF findings still go to the file sink) ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=torda

# DELIBERATELY NOT SET — each silently degrades an eBPF security agent:
#   MemoryDenyWriteExecute=true (blocks the eBPF JIT), ProtectSystem=strict,
#   ProtectKernelTunables=true, SystemCallFilter=…, PrivateDevices=true,
#   RestrictAddressFamilies=… . Tighten per-kernel ONLY after confirming eBPF/ETW
#   capture still works.

[Install]
WantedBy=multi-user.target
