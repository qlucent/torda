# systemd unit installed by the .deb / .rpm package (see crates/agent/Cargo.toml
# [package.metadata.deb] / [package.metadata.generate-rpm]). Same as
# deploy/torda.service but ExecStart points at the packaged binary
# location (/usr/bin) instead of the manual-install /usr/local/bin.
#
# The package does NOT enable this unit automatically. After install:
#   sudoedit /etc/torda/config.toml     # set daemon mode + output path
#   sudo systemctl enable --now torda
#
# NOTE: the packaged binary is the DEFAULT (stub) build unless you installed the
# eBPF/ETW package variant. eBPF collection needs root or CAP_BPF+CAP_PERFMON;
# without the platform feature or the privilege the agent fails soft to the stub
# bus (see docs/DEPLOY.md).

[Unit]
Description=torda — unified security agent (daemon mode, OCSF file sink)
Documentation=https://github.com/qlucent/torda
After=network-online.target
Wants=network-online.target
# Crash-loop guard: stop retrying after 5 failed starts in 60s (a manual
# `systemctl reset-failed torda` clears it).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/torda --config /etc/torda/config.toml
Restart=on-failure
RestartSec=5s

# --- Footprint bounds: keep it "one light agent". Tune for your fleet. ---
MemoryHigh=192M
MemoryMax=256M
CPUQuota=40%
TasksMax=128

# --- Least privilege: run as root (collection needs it) but BOUND the capability
# set to what collection actually uses, so a compromise of the agent can't wield
# the rest of root. eBPF load needs CAP_BPF + CAP_PERFMON (kernel >= 5.8) or
# CAP_SYS_ADMIN (older); reading /proc + package DBs needs CAP_DAC_READ_SEARCH /
# CAP_SYS_PTRACE. Add caps here if your kernel needs them. ---
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYSLOG

# --- Sandboxing that does NOT interfere with eBPF/ETW collection ---
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
RestrictRealtime=true
LockPersonality=true
# systemd creates /var/log/torda (0755) and makes it writable — no pre-create,
# no ReadWritePaths-on-missing-dir startup failure. Point the OCSF file sink here.
LogsDirectory=torda

# --- Agent diagnostics to the journal (OCSF findings still go to the file sink) ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=torda

# DELIBERATELY NOT SET — each of these silently degrades an eBPF security agent:
#   MemoryDenyWriteExecute=true   # blocks the eBPF JIT (W^X)
#   ProtectSystem=strict          # hides paths the collectors read
#   ProtectKernelTunables=true / SystemCallFilter=…   # blocks bpf()/perf paths
#   PrivateDevices=true / RestrictAddressFamilies=…
# A security agent legitimately needs broad kernel visibility; tighten these
# per-kernel ONLY after confirming eBPF/ETW capture still works.

[Install]
WantedBy=multi-user.target
