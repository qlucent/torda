# Secure collector profile — copy this to `.env` in this directory and set a
# STRONG password, then: docker compose -f docker-compose.secure.yml up -d
#
# OpenSearch 2.x rejects weak passwords: use 8+ characters with at least one
# uppercase, one lowercase, one digit, and one special character, and not similar
# to the username (e.g. don't put "admin" in it), or the node won't start.
OPENSEARCH_ADMIN_PASSWORD=Change-Me-To-A-Str0ng!Passphrase
# Password for the least-privilege `torda-ingest` user Vector authenticates as
# (provisioned automatically on first boot). Use a different strong value.
OPENSEARCH_INGEST_PASSWORD=Change-Me-To-A-Different-Str0ng!Pass
