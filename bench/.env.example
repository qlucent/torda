# Copy to .env and adjust. Pin every version so runs are reproducible (spec §5).
TORDA_REF=main                 # torda git ref the target images build from
IMAGE_UBUNTU=torda-bench-ubuntu
IMAGE_ROCKY=torda-bench-rocky
WAZUH_VERSION=4.9.0            # peer baseline, pinned + documented (fairness guard)
OSQUERY_VERSION=5.12.1        # footprint peer
SINK=/var/log/torda/bench.ndjson
BTF=/sys/kernel/btf/vmlinux
# Sinkhole targets for the C2 atomics (never the internet):
SINK_LOOPBACK=127.0.0.1
SINK_EXTERNAL=203.0.113.10     # TEST-NET-3: external-classified + unroutable
SINK_PORT=4444
